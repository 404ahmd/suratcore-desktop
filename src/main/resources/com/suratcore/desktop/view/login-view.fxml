<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.suratcore.desktop.controller.LoginController"
           stylesheets="@../css/style.css" styleClass="login-root">

    <VBox alignment="CENTER" spacing="0">
        <VBox styleClass="login-card" maxWidth="420.0" spacing="20.0">
            <padding>
                <Insets top="36.0" right="36.0" bottom="36.0" left="36.0"/>
            </padding>

            <!-- Brand Header -->
            <VBox spacing="6.0" alignment="CENTER">
                <Label text="SURATCORE" styleClass="brand-logo"/>
                <Label text="Sistem Manajemen Registrasi Surat Perusahaan" styleClass="brand-subtitle"/>
            </VBox>

            <Separator/>

            <!-- Error Banner -->
            <Label fx:id="lblError" text="Pesan Error" wrapText="true"
                   styleClass="alert-danger" maxWidth="Infinity" visible="false"/>

            <!-- Form Inputs -->
            <VBox spacing="16.0">
                <VBox spacing="6.0">
                    <Label text="Username" styleClass="field-label"/>
                    <TextField fx:id="txtUsername" promptText="Masukkan username Anda" styleClass="input-field"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Password" styleClass="field-label"/>
                    <PasswordField fx:id="txtPassword" promptText="Masukkan password Anda"
                                   styleClass="input-field" onAction="#handleLogin"/>
                </VBox>
            </VBox>

            <!-- Action Area -->
            <VBox spacing="12.0" alignment="CENTER">
                <Button fx:id="btnLogin" text="Masuk ke Sistem" maxWidth="Infinity"
                        styleClass="btn-primary-large" onAction="#handleLogin" defaultButton="true"/>

                <HBox alignment="CENTER" spacing="8.0">
                    <ProgressIndicator fx:id="progressIndicator" prefWidth="22.0" prefHeight="22.0"/>
                </HBox>
            </VBox>

            <!-- Footer info -->
            <Label text="Aplikasi Desktop SuratCore Enterprise • Terproteksi JWT"
                   styleClass="footer-hint" alignment="CENTER" maxWidth="Infinity"/>
        </VBox>
    </VBox>
</StackPane>
