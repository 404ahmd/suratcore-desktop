<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.suratcore.desktop.controller.DashboardController"
      stylesheets="@../css/style.css" styleClass="dashboard-root" spacing="16.0">

    <!-- Top Navigation Header -->
    <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16.0">
        <padding>
            <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
        </padding>

        <VBox spacing="2.0">
            <Label text="SURATCORE" styleClass="navbar-brand"/>
            <Label text="Sistem Manajemen Nomor Surat &amp; Dokumen Perusahaan" styleClass="navbar-tagline"/>
        </VBox>

        <Pane HBox.hgrow="ALWAYS"/>

        <!-- User profile area -->
        <HBox alignment="CENTER" spacing="12.0">
            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <Label fx:id="lblUserGreeting" text="Nama Petugas" styleClass="user-name"/>
                <Label fx:id="lblUserRole" text="ADMIN" styleClass="role-badge"/>
            </VBox>
            <Button text="Keluar" onAction="#handleLogout" styleClass="btn-logout"/>
        </HBox>
    </HBox>

    <!-- Main Content Body -->
    <VBox spacing="16.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="0" right="24.0" bottom="16.0" left="24.0"/>
        </padding>

        <!-- Metrics / KPI Summary Cards -->
        <HBox spacing="16.0">
            <!-- Total Surat -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="6.0">
                <Label text="TOTAL REGISTRASI SURAT" styleClass="metric-title"/>
                <Label fx:id="lblTotalSurat" text="0" styleClass="metric-value"/>
                <Label text="Semua dokumen terdaftar" styleClass="metric-hint"/>
            </VBox>

            <!-- Diproses -->
            <VBox styleClass="metric-card, metric-card-warning" HBox.hgrow="ALWAYS" spacing="6.0">
                <Label text="STATUS DIPROSES" styleClass="metric-title"/>
                <Label fx:id="lblSuratDiproses" text="0" styleClass="metric-value, text-warning"/>
                <Label text="Menunggu tindak lanjut" styleClass="metric-hint"/>
            </VBox>

            <!-- Selesai -->
            <VBox styleClass="metric-card, metric-card-success" HBox.hgrow="ALWAYS" spacing="6.0">
                <Label text="STATUS SELESAI" styleClass="metric-title"/>
                <Label fx:id="lblSuratSelesai" text="0" styleClass="metric-value, text-success"/>
                <Label text="Surat telah tuntas" styleClass="metric-hint"/>
            </VBox>

            <!-- Divisi -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="6.0">
                <Label text="TOTAL DIVISI" styleClass="metric-title"/>
                <Label fx:id="lblTotalDivisi" text="0" styleClass="metric-value"/>
                <Label text="Unit kerja terdaftar" styleClass="metric-hint"/>
            </VBox>
        </HBox>

        <!-- Action & Filter Bar -->
        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="filter-container">
            <padding>
                <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
            </padding>

            <!-- Search input -->
            <TextField fx:id="txtSearch" promptText="🔍 Cari nomor surat, perihal, atau divisi..."
                       HBox.hgrow="ALWAYS" styleClass="input-field"/>

            <!-- Status Filter -->
            <ComboBox fx:id="cbFilterStatus" prefWidth="160.0" styleClass="input-field"/>

            <!-- Divisi Filter -->
            <ComboBox fx:id="cbFilterDivisi" prefWidth="200.0" styleClass="input-field"/>

            <Button fx:id="btnRefresh" text="⟳ Refresh" onAction="#loadDivisionsAndData"
                    styleClass="btn-secondary"/>

            <!-- Primary Generate Button -->
            <Button fx:id="btnGenerateNomor" text="＋ Generate Nomor Baru"
                    onAction="#handleOpenGenerateDialog" styleClass="btn-primary-accent"/>
        </HBox>

        <!-- Main Registrasi Surat Table -->
        <VBox VBox.vgrow="ALWAYS" styleClass="table-wrapper">
            <TableView fx:id="tblSurat" VBox.vgrow="ALWAYS" styleClass="custom-table">
                <columns>
                    <TableColumn fx:id="colNo" text="No" prefWidth="50.0" resizable="false"/>
                    <TableColumn fx:id="colNomorSurat" text="Nomor Registrasi Surat" prefWidth="240.0"/>
                    <TableColumn fx:id="colDivisi" text="Divisi" prefWidth="170.0"/>
                    <TableColumn fx:id="colKeterangan" text="Keterangan / Perihal" prefWidth="300.0"/>
                    <TableColumn fx:id="colTanggal" text="Tanggal" prefWidth="110.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120.0"/>
                    <TableColumn fx:id="colAction" text="Aksi" prefWidth="180.0" resizable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <VBox alignment="CENTER" spacing="8.0">
                        <Label text="Belum ada data registrasi surat" styleClass="empty-title"/>
                        <Label text="Klik tombol '+ Generate Nomor Baru' untuk mendaftarkan dokumen pertama"
                               styleClass="empty-subtitle"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Bottom Status Bar -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="6.0" right="8.0" bottom="6.0" left="8.0"/>
            </padding>
            <ProgressIndicator fx:id="progressIndicator" prefWidth="16.0" prefHeight="16.0"/>
            <Label fx:id="lblStatus" text="Siap digunakan" styleClass="status-text"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="REST API Endpoint: /api/registrasi-surat" styleClass="api-tag"/>
        </HBox>
    </VBox>
</VBox>

